<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.azalogistics.pda">

    <!-- ================== PERMISOS ================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Popup de "hay versión nueva": descargar e instalar el APK actualizado. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- ================== WALKIE (PTT por LAN) ================== -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ================== HARDWARE ================== -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- ================== PERMISOS ================== -->

    <queries>
        <package android:name="es.tlsi.mobile" />
        <package android:name="com.android.calculator2" />
        <package android:name="com.google.android.calculator" />
        <package android:name="com.datalogic.scan2deploy" />
        <package android:name="com.mediatek.camera" />
        <package android:name="com.android.camera" />
        <package android:name="com.android.camera2" />
        <package android:name="com.google.android.apps.photos" />
        <package android:name="com.google.android.apps.docs" />
        <package android:name="com.aza.scanner" />
        <package android:name="com.android.cameraextensions" />
    </queries>




    <!-- ================== APLICACIÓN ================== -->
    <application
        android:name="com.azalogistics.walkie.App"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Sistema PDA Aza"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- SDK Datalogic (número de serie del dispositivo). required="false": la app
             debe poder instalarse también en equipos de pruebas que no sean PDA Datalogic. -->
        <uses-library
            android:name="com.datalogic.device"
            android:required="false" />

        <!-- 🔥 FILE PROVIDER (CÁMARA) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.azalogistics.pda.provider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ================== ACTIVIDAD PRINCIPAL ================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>


</activity>

        <!-- Mini-navegador interno para CD Muelles/ActivaLink (ver ExternalWebActivity). -->
        <activity
            android:name=".ExternalWebActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ================== WALKIE (PTT por LAN) ================== -->
        <activity
            android:name="com.azalogistics.walkie.ui.MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name="com.azalogistics.walkie.service.WalkieService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <receiver
            android:name="com.azalogistics.walkie.service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Opcional: PTT global con tecla física. El usuario debe activarlo en Ajustes > Accesibilidad. -->
        <service
            android:name="com.azalogistics.walkie.service.PttAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ptt_accessibility_config" />
        </service>

    </application>

</manifest>