<?xml version="1.0" encoding="utf-8"?>
<!--
  filterKeyEvents + flagRequestFilterKeyEvents lets the service receive global
  key events (incl. volume keys) even when WalkieLAN is not in foreground.
  This is the most robust way to implement a global hardware PTT on stock Android.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:notificationTimeout="50"
    android:description="@string/ptt_accessibility_desc" />
